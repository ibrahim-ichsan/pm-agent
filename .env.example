# Copy these names into Heroku > Settings > Config Vars. Never commit real values.
TELEGRAM_TOKEN=
OWNER_TELEGRAM_ID=
# Optional: how you are named in meeting notes, so the bot knows which items are yours
OWNER_NAMES=
NOTION_TOKEN=
NOTION_TASKS_DS=
NOTION_APPLICATIONS_DS=
NOTION_SHIFTS_DS=
NOTION_STATE_DS=
NOTION_ROADMAP_DS=
# Fast free model for reading messages (console.groq.com). Tried first; Gemini is the fallback and reads PDFs.
GROQ_API_KEY=
# Or any other OpenAI-compatible provider instead of Groq:
# LLM_BASE_URL=  LLM_API_KEY=  LLM_MODEL=  LLM_NAME=
GEMINI_API_KEY=
# Optional: pin a model; empty picks the newest Flash model your key can use
GEMINI_MODEL=
# Optional: your own daily call budget, to get a warning at 80%
GEMINI_DAILY_LIMIT=
# The whole service-account JSON file, pasted as one value
GOOGLE_SERVICE_ACCOUNT_JSON=
# Comma-separated calendar IDs to read (the calendar's email address)
CALENDAR_IDS=
# Calendar the bot writes to; defaults to the first of CALENDAR_IDS
CALENDAR_WRITE_ID=
